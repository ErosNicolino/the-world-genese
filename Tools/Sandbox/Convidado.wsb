<!-- Um "segundo PC" para testar a sala online: dois cliques abrem a Área Restrita do Windows (Windows
     Sandbox) com outro usuário, outra rede e outro id da Epic, e o jogo do pacote (Build\Alpha\Windows)
     abre lá dentro como convidado. Requer o recurso "Área Restrita do Windows" ligado. -->
<Configuration>
  <vGPU>Enable</vGPU>
  <Networking>Enable</Networking>
  <MemoryInMB>6144</MemoryInMB>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>C:\Users\Valorant Niko\Documents\ChatGPT\Mangas\Vortex-UE5-migracao\Vortex\Build\Alpha\Windows</HostFolder>
      <SandboxFolder>C:\Jogo</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd /c "C:\Jogo\Engine\Extras\Redist\en-us\vc_redist.x64.exe /install /quiet /norestart &amp; start "" C:\Jogo\Vortex.exe -windowed -ResX=1280 -ResY=720"</Command>
  </LogonCommand>
</Configuration>
